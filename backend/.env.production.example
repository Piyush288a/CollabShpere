# CollabSphere Backend - Production Environment Variables
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/collabsphere?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication
JWT_SECRET=generate_a_long_random_64_char_hex_string_here
JWT_EXPIRES_IN=7d

# Allowed Frontend URL(s) for CORS & Socket.IO (comma-separated if multiple, e.g. Vercel custom domain & preview URLs)
CLIENT_URL=https://collabsphere.vercel.app,https://collabsphere-*.vercel.app

# Cloudinary (Photo & Asset Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Future Phase: Real-Time AI Analysis
# Google Gemini API key
GEMINI_API_KEY=
